# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram user ID (get it from @userinfobot).
# This is the ONLY id ever allowed past Gate 1 — everyone else is silently denied.
AUTHORIZED_USER_ID=your_telegram_user_id_here

# ── Voice authentication (Gate 3) ───────────────────────────────────────────────
# Cosine similarity between the enrolled voiceprint and the incoming sample.
# 0.50 is a reasonable starting point for SpeechBrain's ECAPA-TDNN model.
# Raise it (e.g. 0.65) to be stricter; lower it if you get false rejects.
SIMILARITY_THRESHOLD=0.50

# Fuzzy-match ratio (difflib SequenceMatcher) between the spoken passphrase and
# the enrolled one, after transcription. Voice similarity and passphrase match
# are both required — this only controls how forgiving the phrase check is of
# transcription noise / mispronunciation.
PASSPHRASE_MATCH_THRESHOLD=0.50

ENROLLMENT_SAMPLES_REQUIRED=8

# ── Session (Gate 2) ─────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=2

# ── ntfy push notifications ───────────────────────────────────────────────────
# Treat the topic name as a secret — anyone who knows it can read your alerts.
# Generate one: openssl rand -hex 16
NTFY_TOPIC=your_secret_random_topic_name
NTFY_SERVER_URL=https://ntfy.sh

# ── Agent backend ──────────────────────────────────────────────────────────────
# Any backend exposing an OpenAI-compatible /v1/chat/completions endpoint:
# a self-hosted LLM gateway, a local model server (vLLM, Ollama + proxy,
# LiteLLM), or a hosted API. Requests are authenticated with a bearer token
# and tagged with X-Session-Id so each Telegram chat keeps its own
# conversation thread on the backend side.
AGENT_API_URL=http://localhost:8000
AGENT_API_KEY=your_agent_backend_api_key_here
AGENT_MODEL_NAME=local-agent

# ── Text-to-speech ───────────────────────────────────────────────────────────────
# Voice replies for voice messages, via edge-tts. Set to false for text-only
# replies regardless of how the user messaged in (still a live, supported path).
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural

# ── Paths (relative to project root / container /app) ─────────────────────────
VOICEPRINT_PATH=./data/voiceprint.npy
ENROLLMENT_DIR=./data/enrollment_samples/
AUTH_LOG_DB=./data/auth_log.db
PIN_HASH_PATH=./data/pin_hash.txt
PASSPHRASE_PATH=./data/passphrase.txt
MODEL_CACHE_DIR=./data/models/
